<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">

  <name>pairs_lib</name>
  <version>1.0.0</version>
  <description>PAIRS shared C++ library — attitude math, filters, parameter loading, geometry utilities, transformations</description>
  <maintainer email="canhthanh@vnu.edu.vn">Thanh Nguyen Canh</maintainer>

  <license>BSD 3-Clause</license>

  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rosidl_default_runtime</depend>
  <depend>ament_cmake_core</depend>
  <depend>rosidl_default_generators</depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>pairs_msgs</depend>
  <depend>launch_ros</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>pcl_ros</depend>
  <depend>libboost-dev</depend>
  <depend>visualization_msgs</depend>
  <depend>eigen</depend>
  <depend>yaml-cpp</depend>
  <depend>nav_msgs</depend>

  <test_depend>ament_cmake_ros</test_depend>
  <test_depend>launch</test_depend>
  <test_depend>launch_ros</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>rclpy</test_depend>

  <!-- Linters -->
  <test_depend>ament_cmake_clang_format</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>


  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
